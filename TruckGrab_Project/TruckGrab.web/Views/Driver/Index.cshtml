@{
    ViewData["Title"] = "Driver Dashboard";
    var driverName = ViewBag.DriverName as string ?? "Driver";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h1 class="mb-1">Hello, @driverName</h1>
            <p class="text-muted mb-3">
                Here are your latest driver stats, including rating, completed orders, and current availability.
            </p>
        </div>
    </div>

    <div id="driverDashboardContent">
        <!-- Driver Info Card -->
        <div class="row mb-4">

            <!-- My Profile -->
            <div class="col-lg-8 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">My Profile</h5>
                    </div>

                    <div class="card-body">

                        <!-- Profile Exists -->
                        <div id="driverProfileContent" class="d-none">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>License Number:</strong> <span id="licenseNumber">-</span></p>
                                    <p><strong>License Class:</strong> <span id="licenseClass">-</span></p>
                                    <p><strong>Experience:</strong> <span id="experience">-</span> years</p>
                                </div>

                                <div class="col-md-6">
                                    <p><strong>Rating:</strong> <span id="rating" class="badge bg-warning">-</span></p>
                                    <p><strong>Status:</strong> <span id="status" class="badge">-</span></p>
                                    <p><strong>Current Truck:</strong> <span id="currentTruck">-</span></p>
                                </div>
                            </div>

                            <div class="mt-3">
                                <a href="@Url.Action("Profile", "Driver")" class="btn btn-primary">
                                    Update Profile
                                </a>
                            </div>
                        </div>

                        <!-- No Profile -->
                        <div id="noDriverProfileContent" class="text-center py-5 d-none">
                            <h5 class="mb-4">
                                You need to create a profile to receive orders
                            </h5>

                            <a href="@Url.Action("CreateProfile", "Driver")"
                               class="btn btn-primary">
                                Create now!
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="col-lg-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Quick Stats</h5>
                    </div>

                    <div class="card-body">
                        <div class="text-center">
                            <h3 id="totalOrders">-</h3>
                            <p class="text-muted">Total Orders</p>

                            <hr>

                            <h3 id="completedOrders">-</h3>
                            <p class="text-muted">Completed Orders</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- My Orders -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">My Recent Orders</h5>

                        <a href="@Url.Action("MyOrders", "Driver")"
                           class="btn btn-primary btn-sm">
                            View All
                        </a>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Order Code</th>
                                        <th>Cargo Type</th>
                                        <th>Pickup Location</th>
                                        <th>Delivery Location</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody id="recentOrders">
                                    <tr>
                                        <td colspan="6" class="text-center">Loading...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- GPS Location Widget -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-primary shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0"><i class="fas fa-map-marker-alt"></i> Live GPS Simulation</h5>
                        <span id="gpsStatus" class="badge bg-light text-primary">Initializing...</span>
                    </div>
                    <div class="card-body p-0">
                        <div id="driverMap" style="height: 300px; width: 100%;"></div>
                    </div>
                    <div class="card-footer py-2 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Drag the pin to simulate your movement. Updates every 1 minute.</small>
                        <small id="lastGpsUpdate" class="text-muted"></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .leaflet-container { font-family: inherit; }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        console.log('[GPS] Driver Dashboard GPS Script Loaded');
        // GPS State
        let map, marker;
        let lat = 10.7769; // Default: Ho Chi Minh City
        let lng = 106.7009;

        $(document).ready(function()
        {
            loadDriverProfile();
            initMap();
            
            // Start periodic updates
            setInterval(updateLocation, 60000); // 1 minute
            
            // Initial update
            setTimeout(updateLocation, 2000);
        });

        function initMap() {
            map = L.map('driverMap').setView([lat, lng], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            marker = L.marker([lat, lng], { draggable: true }).addTo(map);
            marker.bindPopup("<b>You are here</b><br>Drag me!").openPopup();

            marker.on('dragend', function(e) {
                const position = marker.getLatLng();
                lat = position.lat;
                lng = position.lng;
                updateLocation(); // Immediate update on drag
            });
        }

        function updateLocation() {
            const data = { lat: lat, lng: lng };
            console.log('[GPS] Sending update:', data);
            
            fetch('/Driver/UpdateLocation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(text => { throw new Error(`Server error (${response.status}): ${text}`) });
                }
                return response.json();
            })
            .then(result => {
                if (result.success) {
                    console.log('[GPS] Update success');
                    $('#gpsStatus').text('Active (Sharing)').removeClass('bg-light text-primary').addClass('bg-success text-white');
                    $('#lastGpsUpdate').text('Last update: ' + new Date().toLocaleTimeString());
                } else {
                    console.error('[GPS] Update failed:', result.message);
                    $('#gpsStatus').text('Update Failed').removeClass('bg-success').addClass('bg-danger text-white');
                }
            })
            .catch(error => {
                console.error('[GPS] Request failed:', error);
                $('#gpsStatus').text('Error: ' + error.message).removeClass('bg-success').addClass('bg-danger text-white');
            });
        }

        // Remove location when page is closed
        window.addEventListener('beforeunload', function (e) {
            fetch('/Driver/GoOffline', { method: 'POST', keepalive: true });
        });

        function loadDriverProfile()
        {
            fetch('/Driver/GetMyProfile')
                .then(response =>
                {
                    if (response.status === 404)
                    {
                        showNoDriverProfile();
                        return null;
                    }

                    if (!response.ok)
                    {
                        throw new Error('Failed to load driver profile');
                    }

                    return response.json();
                })
                .then(data =>
                {
                    if (!data)
                    {
                        return;
                    }

                    $('#driverProfileContent').removeClass('d-none');
                    $('#noDriverProfileContent').addClass('d-none');

                    $('#licenseNumber').text(data.licenseNumber || '-');
                    $('#licenseClass').text(data.licenseClass || '-');
                    $('#experience').text(data.experienceYears || '-');
                    $('#rating').text(data.ratingAvg ? data.ratingAvg.toFixed(1) + ' ★' : '-');
                    $('#currentTruck').text(data.currentTruckId || 'None');

                    const statusBadge = $('#status');

                    statusBadge.removeClass('bg-success bg-info bg-secondary');

                    switch (data.status)
                    {
                        case 'Available':
                            statusBadge.addClass('bg-success').text('Available');
                            break;

                        case 'OnDelivery':
                            statusBadge.addClass('bg-info').text('On Delivery');
                            break;

                        case 'OffDuty':
                            statusBadge.addClass('bg-secondary').text('Off Duty');
                            break;

                        default:
                            statusBadge.addClass('bg-secondary').text(data.status || 'Unknown');
                    }

                    loadDriverOrders();
                })
                .catch(error =>
                {
                    console.error('Error loading profile:', error);
                    showNoDriverProfile();
                });
        }

        function showNoDriverProfile()
        {
            $('#driverProfileContent').addClass('d-none');
            $('#noDriverProfileContent').removeClass('d-none');
        }

        function loadDriverOrders()
        {
            fetch('/Driver/GetMyOrders')
                .then(response => response.json())
                .then(data =>
                {
                    $('#totalOrders').text(data.totalOrders || 0);
                    $('#completedOrders').text(data.completedOrders || 0);

                    const tbody = $('#recentOrders');
                    tbody.empty();

                    if (data.recentOrders && data.recentOrders.length > 0)
                    {
                        data.recentOrders.forEach(order =>
                        {
                            const statusBadge = getStatusBadge(order.status);

                            tbody.append(`
                                <tr>
                                    <td>${order.orderCode}</td>
                                    <td>${order.cargoType}</td>
                                    <td>${order.pickupLocation || '-'}</td>
                                    <td>${order.deliveryLocation || '-'}</td>
                                    <td>${statusBadge}</td>
                                    <td>
                                        <a href="/Driver/OrderDetails/${order.id}"
                                           class="btn btn-sm btn-info">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            `);
                        });
                    }
                    else
                    {
                        tbody.append(`
                            <tr>
                                <td colspan="6" class="text-center">
                                    No orders found
                                </td>
                            </tr>
                        `);
                    }
                })
                .catch(error =>
                {
                    console.error('Error loading orders:', error);
                });
        }



        function getStatusBadge(status)
        {
            const badges =
            {
                'Pending': '<span class="badge bg-warning">Pending</span>',
                'Confirmed': '<span class="badge bg-info">Confirmed</span>',
                'OnTheWay': '<span class="badge bg-primary">On The Way</span>',
                'Completed': '<span class="badge bg-success">Completed</span>',
                'Cancelled': '<span class="badge bg-danger">Cancelled</span>'
            };

            return badges[status] || `<span class="badge bg-secondary">${status}</span>`;
        }
    </script>
}

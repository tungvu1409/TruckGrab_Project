@using System.Security.Claims
@{
    ViewData["Title"] = "Driver Dashboard";
    var userName = User.Identity?.Name;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-id-card text-accent-cyan"></i>
        <span>Trạng thái hoạt động</span>
    </div>
    <div class="d-flex gap-2">
        <button id="statusBtn" class="btn btn-sm btn-success fw-bold px-3">
            <i class="fas fa-circle me-1 small"></i> <span id="statusText">Online</span>
        </button>
        <a href="#" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
            <i class="fas fa-sign-out-alt"></i>
        </a>
    </div>
</div>

<div class="dispatch-stats-grid">
    <div class="dispatch-stat-card cyan">
        <div class="stat-header">TỔNG ĐƠN HÀNG</div>
        <div class="stat-main-value" id="totalOrders">0</div>
        <div class="stat-sub-info">Tất cả thời gian</div>
    </div>
    <div class="dispatch-stat-card green">
        <div class="stat-header">ĐÃ HOÀN THÀNH</div>
        <div class="stat-main-value" id="completedOrders">0</div>
        <div class="stat-sub-info">Đơn hàng thành công</div>
    </div>
    <div class="dispatch-stat-card orange">
        <div class="stat-header">ĐIỂM ĐÁNH GIÁ</div>
        <div class="stat-main-value" id="rating">0.0</div>
        <div class="stat-sub-info">Dựa trên phản hồi khách</div>
    </div>
    <div class="dispatch-stat-card purple">
        <div class="stat-header">GIẤY PHÉP</div>
        <div class="stat-main-value" id="licenseClass" style="font-size: 1.5rem; height: 3rem; display: flex; align-items: center;">-</div>
        <div class="stat-sub-info" id="licenseNumber">-</div>
    </div>
</div>

<div class="dashboard-content-grid">
    <div class="map-container-card">
        <div class="card-header-simple">
            <span><i class="fas fa-location-crosshairs me-2"></i>Vị trí hiện tại (GPS Simulation)</span>
        </div>
        <div id="dispatchLiveMap"></div>
        <div class="map-legend">
            <small class="text-secondary">Kéo thả điểm đánh dấu để mô phỏng di chuyển thực tế.</small>
            <div class="ms-auto small text-secondary" id="lastGpsUpdate"></div>
        </div>
    </div>

    <div class="orders-panel">
        <div class="card-header-simple border-bottom border-secondary pb-2 mb-2">
            <span><i class="fas fa-list-check me-2"></i>Đơn hàng gần đây</span>
        </div>
        <div id="recentOrdersMobile" class="flex-grow-1">
            <div class="text-center py-5 text-secondary">Đang tải...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map, marker;
        const driverId = @(User.FindFirst(ClaimTypes.NameIdentifier)?.Value);

        $(document).ready(function() {
            initMap();
            loadDriverProfile();
            loadDriverOrders();
            setInterval(loadDriverOrders, 30000);
        });

        function initMap() {
            map = L.map('dispatchLiveMap').setView([21.0285, 105.8542], 15);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '&copy; OSM' }).addTo(map);
            marker = L.marker([21.0285, 105.8542], { draggable: true }).addTo(map);
            marker.on('dragend', function(e) {
                const pos = marker.getLatLng();
                updateGpsPosition(pos.lat, pos.lng);
            });
        }

        function loadDriverProfile() {
            fetch('/Driver/GetProfile')
                .then(r => r.json())
                .then(d => {
                    if (d) {
                        $('#licenseClass').text(d.licenseClass);
                        $('#licenseNumber').text(d.licenseNumber);
                        $('#rating').text(d.rating.toFixed(1));
                        $('#statusText').text(d.status);
                        const btn = $('#statusBtn').removeClass('btn-success btn-warning btn-danger');
                        if (d.status === 'Available') btn.addClass('btn-success');
                        else if (d.status === 'Busy') btn.addClass('btn-warning');
                        else btn.addClass('btn-danger');
                    }
                });
        }

        function loadDriverOrders() {
            fetch('/Driver/GetMyOrders')
                .then(r => r.json())
                .then(data => {
                    $('#totalOrders').text(data.totalOrders);
                    $('#completedOrders').text(data.completedOrders);
                    const list = $('#recentOrdersMobile').empty();
                    if (data.recentOrders?.length > 0) {
                        data.recentOrders.forEach(o => {
                            list.append(`
                                <div class="order-item-compact">
                                    <div class="order-id-status"><span class="order-code">${o.orderCode}</span><span class="order-status-pill">${o.status}</span></div>
                                    <div class="order-company">${o.cargoType}</div>
                                    <div class="mt-2 text-end"><a href="/Driver/OrderDetails/${o.id}" class="btn btn-xs btn-outline-cyan py-0" style="font-size:0.7rem">CHI TIẾT</a></div>
                                </div>
                            `);
                        });
                    } else list.append('<div class="text-center py-5 text-secondary">Chưa có đơn hàng nào</div>');
                });
        }

        function updateGpsPosition(lat, lng) {
            fetch('/Driver/UpdateLocation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ driverId, lat, lng })
            }).then(() => $('#lastGpsUpdate').text('Cập nhật lúc: ' + new Date().toLocaleTimeString()));
        }
    </script>
}
@{ Layout = "_DispatchLayout"; }

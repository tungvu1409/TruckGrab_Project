@model TruckGrab.web.Models.Driver
@{
    ViewData["Title"] = "Hồ sơ tài xế";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-id-card text-accent-cyan"></i>
        <span>Hồ sơ tài xế chuyên nghiệp</span>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 border-success text-success mb-4">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <div class="dispatch-stat-card border-top-0 p-4">
            <form asp-action="EditDriverProfile" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-4 text-center">
                    <div class="bg-accent-orange bg-opacity-10 text-accent-orange fw-bold rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem; border: 2px dashed var(--accent-orange);">
                        <i class="fas fa-truck-driver"></i>
                    </div>
                    <h4 class="text-white mb-0">Hồ sơ nghề nghiệp</h4>
                    <p class="text-secondary small">Quản lý giấy phép và kinh nghiệm lái xe</p>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label text-secondary small fw-bold">SỐ GIẤY PHÉP LÁI XE</label>
                        <input name="licenseNumber" value="@Model.LicenseNumber" class="form-control bg-dark border-secondary text-white" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-bold">HẠNG BẰNG LÁI</label>
                        <select name="licenseClass" class="form-select bg-dark border-secondary text-white">
                            <option value="B2" selected="@(Model.LicenseClass == "B2")">B2 - Xe tải < 3.5 tấn</option>
                            <option value="C" selected="@(Model.LicenseClass == "C")">C - Xe tải >= 3.5 tấn</option>
                            <option value="D" selected="@(Model.LicenseClass == "D")">D - Xe khách</option>
                            <option value="E" selected="@(Model.LicenseClass == "E")">E - Xe khách > 30 chỗ</option>
                            <option value="FC" selected="@(Model.LicenseClass == "FC")">FC - Xe đầu kéo</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-bold">KINH NGHIỆM (NĂM)</label>
                        <input name="experienceYears" type="number" value="@Model.ExperienceYears" class="form-control bg-dark border-secondary text-white" />
                    </div>

                    <div class="col-12 mt-4">
                        <div class="p-3 bg-dark bg-opacity-25 rounded-3 border border-secondary border-opacity-10">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-secondary small fw-bold">ĐIỂM ĐÁNH GIÁ TRUNG BÌNH</span>
                                <span class="text-warning fw-bold">@Model.RatingAvg.ToString("0.0") <i class="fas fa-star ms-1"></i></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary small fw-bold">TRẠNG THÁI HIỆN TẠI</span>
                                <span class="badge bg-@(Model.Status == TruckGrab.web.Models.DriverStatus.Active ? "success" : "secondary")">@Model.Status</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-10">
                    <button type="submit" class="btn btn-warning w-100 fw-bold py-2 shadow-sm">
                        CẬP NHẬT HỒ SƠ NGHỀ NGHIỆP <i class="fas fa-check-circle ms-2"></i>
                    </button>
                    <div class="text-center mt-3">
                        <a href="@Url.Action("Profile", "Account")" class="text-accent-cyan small"><i class="fas fa-user-gear me-1"></i> Chỉnh sửa thông tin tài khoản</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
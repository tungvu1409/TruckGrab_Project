@model TruckGrab.web.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-circle-info text-accent-cyan"></i>
        <span>Chi tiết đơn @Model.OrderCode</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("MyOrders", "Driver")" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Danh sách đơn
        </a>
    </div>
</div>

<div class="row g-4 mt-1">
    <!-- Main Info -->
    <div class="col-lg-8">
        <div class="card bg-secondary bg-opacity-10 border-0 rounded-4 mb-4">
            <div class="card-header bg-dark bg-opacity-25 py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-box me-2"></i>Thông tin hàng hóa</h6>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Loại hàng</label>
                            <div class="h5 fw-bold text-accent-cyan">@Model.CargoType</div>
                        </div>
                        <div class="mb-4">
                            <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Khối lượng</label>
                            <div class="h5 fw-bold">@Model.Weight kg</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Quãng đường</label>
                            <div class="h5 fw-bold">@Model.DistanceKm km</div>
                        </div>
                        <div class="mb-4">
                            <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Thành tiền</label>
                            <div class="h5 fw-bold text-warning">@Model.TotalPrice.ToString("N0") đ</div>
                        </div>
                    </div>
                </div>

                <hr class="border-secondary opacity-25" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-secondary small fw-bold text-uppercase d-block mb-2"><i class="fas fa-location-dot text-danger me-1"></i>ĐỊA ĐIỂM BỐC HÀNG</label>
                        <p class="mb-0 fw-bold">@Model.PickupLocationAddress</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-secondary small fw-bold text-uppercase d-block mb-2"><i class="fas fa-flag-checkered text-success me-1"></i>ĐỊA ĐIỂM GIAO HÀNG</label>
                        <p class="mb-0 fw-bold">@Model.DeliveryLocationAddress</p>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.OrderLogs != null)
        {
            var logs = ViewBag.OrderLogs as List<TruckGrab.web.Models.OrderStatusLog>;
            if (logs != null && logs.Any())
            {
                <div class="card bg-secondary bg-opacity-10 border-0 rounded-4">
                    <div class="card-header bg-dark bg-opacity-25 py-3">
                        <h6 class="mb-0 fw-bold"><i class="fas fa-clock-rotate-left me-2"></i>Lịch sử trạng thái</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 small">
                                <thead>
                                    <tr class="text-secondary">
                                        <th class="ps-3 border-0">THỜI GIAN</th>
                                        <th class="border-0">THAY ĐỔI</th>
                                        <th class="border-0">GHI CHÚ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in logs)
                                    {
                                        <tr>
                                            <td class="ps-3">@log.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><span class="text-accent-cyan">@log.OldStatus</span> <i class="fas fa-arrow-right mx-1 small opacity-50"></i> <span class="text-warning">@log.NewStatus</span></td>
                                            <td class="text-secondary">@log.Note</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Sidebar Status -->
    <div class="col-lg-4">
        <div class="card bg-secondary bg-opacity-10 border-0 rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-dark bg-opacity-25 py-3">
                <h6 class="mb-0 fw-bold">Trạng thái vận hành</h6>
            </div>
            <div class="card-body">
                <div class="mb-4 text-center">
                    <span class="badge rounded-pill bg-@(Model.Status.ToLower() switch {
                        "pending" => "warning text-dark",
                        "assigned" => "info text-dark",
                        "picking" => "primary",
                        "in_transit" => "primary",
                        "delivered" => "success",
                        "cancelled" => "danger",
                        _ => "secondary"
                    }) px-4 py-2 fs-6">
                        @Model.Status.ToUpper().Replace("_", " ")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Thời gian dự kiến bốc</label>
                    <div class="fw-bold">@(Model.ScheduledPickupTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa sắp xếp")</div>
                </div>
                <div class="mb-3">
                    <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Thời gian bốc thực tế</label>
                    <div class="fw-bold">@(Model.ActualPickupTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thực hiện")</div>
                </div>
                <div class="mb-0">
                    <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Thời gian giao thực tế</label>
                    <div class="fw-bold">@(Model.ActualDeliveryTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thực hiện")</div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2">
            @if (Model.Status == TruckGrab.web.Models.Order.Statuses.Assigned || Model.Status == TruckGrab.web.Models.Order.Statuses.Picking)
            {
                <form asp-action="ConfirmPickup" asp-route-orderId="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning w-100 fw-bold py-3 text-dark">
                        XÁC NHẬN BỐC HÀNG <i class="fas fa-truck-loading ms-2"></i>
                    </button>
                </form>
            }
            else if (Model.Status == TruckGrab.web.Models.Order.Statuses.InTransit)
            {
                <form asp-action="ConfirmDelivery" asp-route-orderId="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success w-100 fw-bold py-3">
                        XÁC NHẬN GIAO HÀNG <i class="fas fa-check-double ms-2"></i>
                    </button>
                </form>
            }
        </div>
    </div>
</div>
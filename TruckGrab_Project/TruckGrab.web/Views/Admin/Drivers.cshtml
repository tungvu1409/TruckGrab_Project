@model IEnumerable<TruckGrab.web.Models.Driver>

@{
    ViewData["Title"] = "Quản lý Tài xế (Hệ thống)";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-id-card text-accent-green"></i>
        <span>Hệ thống Quản lý Tài xế</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("CreateDriver", "Admin")" class="btn btn-sm btn-warning fw-bold px-3">
            <i class="fas fa-plus me-1"></i> Thêm tài xế mới
        </a>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card bg-secondary bg-opacity-10 border-0 shadow-sm overflow-hidden">
            <div class="card-header border-bottom border-secondary bg-transparent py-3">
                <h6 class="mb-0 fw-bold text-secondary">DANH SÁCH TÀI XẾ CHI TIẾT</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-dark mb-0 align-middle">
                        <thead class="bg-dark bg-opacity-50">
                            <tr class="text-secondary small">
                                <th class="ps-3 py-3 border-secondary">ID</th>
                                <th class="border-secondary">USER ID</th>
                                <th class="border-secondary">BẰNG LÁI</th>
                                <th class="border-secondary">HẠNG</th>
                                <th class="border-secondary text-center">KINH NGHIỆM</th>
                                <th class="border-secondary">ĐÁNH GIÁ</th>
                                <th class="border-secondary">TRẠNG THÁI</th>
                                <th class="border-secondary">XE HIỆN TẠI</th>
                                <th class="text-center pe-3 border-secondary">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var driver in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-accent-green">#@driver.Id</td>
                                    <td class="small opacity-75">@driver.UserId</td>
                                    <td class="small">@driver.LicenseNumber</td>
                                    <td><span class="badge bg-secondary bg-opacity-50 border border-secondary">@driver.LicenseClass</span></td>
                                    <td class="text-center">@driver.ExperienceYears năm</td>
                                    <td>
                                        <span class="text-warning fw-bold">@driver.RatingAvg.ToString("0.0") <i class="fas fa-star small"></i></span>
                                    </td>
                                    <td>
                                        @switch (driver.Status)
                                        {
                                            case TruckGrab.web.Models.DriverStatus.Active:
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-3">ONLINE</span>
                                                break;
                                            case TruckGrab.web.Models.DriverStatus.Off:
                                                <span class="badge bg-secondary px-3">OFFLINE</span>
                                                break;
                                            default:
                                                <span class="badge bg-info px-3">@driver.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="small">@(driver.CurrentTruckId?.ToString() ?? "N/A")</td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group">
                                            <a href="@Url.Action("DriverDetails", "Admin", new { id = driver.Id })" class="btn btn-xs btn-outline-info">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("EditDriver", "Admin", new { id = driver.Id })" class="btn btn-xs btn-outline-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-xs btn-outline-danger" onclick="deleteDriver(@driver.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteDriver(driverId) {
            if (confirm('Xác nhận xóa tài xế này? Thao tác không thể hoàn tác.')) {
                fetch(`/Admin/DeleteDriver/${driverId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).then(r => r.json()).then(data => {
                    if (data.success) location.reload();
                    else alert('Lỗi: ' + data.message);
                });
            }
        }
    </script>
}
@model IEnumerable<TruckGrab.web.Models.Driver>

@{
    ViewData["Title"] = "Drivers Management";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Drivers Management</h3>
                    <a href="@Url.Action("CreateDriver", "Admin")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add New Driver
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>User ID</th>
                                    <th>License Number</th>
                                    <th>License Class</th>
                                    <th>Experience (Years)</th>
                                    <th>Rating</th>
                                    <th>Status</th>
                                    <th>Current Truck</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var driver in Model)
                                {
                                    <tr>
                                        <td>@driver.Id</td>
                                        <td>@driver.UserId</td>
                                        <td>@driver.LicenseNumber</td>
                                        <td>@driver.LicenseClass</td>
                                        <td>@driver.ExperienceYears</td>
                                        <td>
                                            <span class="badge bg-warning">@driver.RatingAvg.ToString("0.0") ★</span>
                                        </td>
                                        <td>
                                            @switch (driver.Status)
                                            {
                                                case TruckGrab.web.Models.DriverStatus.Active:
                                                    <span class="badge bg-success">Active</span>
                                                    break;
                                                case TruckGrab.web.Models.DriverStatus.Off:
                                                    <span class="badge bg-info">Off</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@(driver.CurrentTruckId?.ToString() ?? "None")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("DriverDetails", "Admin", new { id = driver.Id })" class="btn btn-sm btn-info">View</a>
                                                <a href="@Url.Action("EditDriver", "Admin", new { id = driver.Id })" class="btn btn-sm btn-warning">Edit</a>
                                                <button class="btn btn-sm btn-danger" onclick="deleteDriver(@driver.Id)">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteDriver(driverId) {
            if (confirm('Are you sure you want to delete this driver? This action cannot be undone.')) {
                fetch(`/Admin/DeleteDriver/${driverId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                });
            }
        }
    </script>
}
@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard Điều Hành";
    Layout = "_DispatchLayout";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-chart-bar text-accent-orange"></i>
        <span>Dashboard Điều Hành</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
            <i class="fas fa-sync-alt me-1"></i> Làm mới
        </button>
        <a href="@Url.Action("ManageOrders", "Admin")" class="btn btn-sm btn-warning fw-bold px-3">
            <i class="fas fa-plus me-1"></i> Đơn hàng mới
        </a>
        <a href="#" class="btn btn-sm btn-outline-danger px-3" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
            <i class="fas fa-sign-out-alt me-1"></i> Đăng xuất
        </a>
    </div>
</div>

<div class="dispatch-stats-grid">
    <div class="dispatch-stat-card orange">
        <div class="stat-header">XE ĐANG HOẠT ĐỘNG</div>
        <div class="stat-main-value" id="activeTrucksCount">0</div>
        <div class="stat-sub-info">/ <span id="totalTrucksCount">0</span> xe tổng • <span id="readyTrucksCount">0</span> sẵn sàng</div>
    </div>
    <div class="dispatch-stat-card cyan">
        <div class="stat-header">ĐƠN HÀNG CHỜ</div>
        <div class="stat-main-value" id="pendingOrdersCount">0</div>
        <div class="stat-sub-info">/ <span id="totalOrdersCount">0</span> đơn tổng • <span id="deliveringCount">0</span> đang giao</div>
    </div>
    <div class="dispatch-stat-card green">
        <div class="stat-header">TÀI XẾ SẴN SÀNG</div>
        <div class="stat-main-value" id="readyDriversCount">0</div>
        <div class="stat-sub-info">/ <span id="totalDriversCount">0</span> tài xế tổng</div>
    </div>
    <div class="dispatch-stat-card purple">
        <div class="stat-header">ĐÃ GIAO HÔM NAY</div>
        <div class="stat-main-value" id="deliveredTodayCount">0</div>
        <div class="stat-sub-info">Doanh thu: <span id="todayRevenue">0</span> đ</div>
    </div>
</div>

<div class="dashboard-content-grid">
    <div class="map-container-card">
        <div class="card-header-simple">
            <span><i class="fas fa-map-location-dot me-2"></i>Bản đồ theo dõi xe thực tế</span>
            <button class="btn btn-xs btn-outline-secondary py-0" style="font-size: 0.7rem;">Fit</button>
        </div>
        <div id="dispatchLiveMap"></div>
        <div class="map-legend">
            <div class="legend-item"><span class="dot" style="background-color: #28c76f;"></span> Sẵn sàng</div>
            <div class="legend-item"><span class="dot" style="background-color: #ff9f43;"></span> Đang chờ</div>
            <div class="legend-item"><span class="dot" style="background-color: #ea5455;"></span> Bảo trì</div>
            <div class="legend-item"><span class="dot" style="background-color: #00cfe8;"></span> Điểm giao</div>
        </div>
    </div>

    <div class="orders-panel">
        <div class="card-header-simple border-bottom border-secondary pb-2 mb-2">
            <span><i class="fas fa-clipboard-list me-2"></i>Đơn hàng mới nhất</span>
        </div>
        <div id="latestOrdersList" class="flex-grow-1">
            <div class="text-center py-5 text-secondary">Đang tải dữ liệu...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map, markers = {};

        $(document).ready(function() {
            initMap();
            loadDashboardData();
            setInterval(loadDashboardData, 30000);
        });

        function initMap() {
            map = L.map('dispatchLiveMap').setView([21.0285, 105.8542], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OSM',
                subdomains: 'abcd',
                maxZoom: 20
            }).addTo(map);
        }

        function loadDashboardData() {
            fetch('/Admin/GetStats')
                .then(r => r.json())
                .then(data => {
                    $('#totalOrdersCount').text(data.totalOrders);
                    $('#pendingOrdersCount').text(data.totalOrders);
                    $('#totalDriversCount').text(data.totalDrivers);
                    $('#readyDriversCount').text(data.totalDrivers);
                    $('#todayRevenue').text(data.totalRevenue.toLocaleString());
                });

            fetch('/Admin/GetRecentActivity')
                .then(r => r.json())
                .then(data => {
                    const list = $('#latestOrdersList');
                    list.empty();
                    data.recentOrders.forEach(o => {
                        list.append(`
                            <div class="order-item-compact">
                                <div class="order-id-status">
                                    <span class="order-code">${o.orderCode}</span>
                                    <span class="order-status-pill">${o.status}</span>
                                </div>
                                <div class="order-company">Công ty Vận tải ${o.orderCode.split('-')[1] || 'TruckGrab'}</div>
                                <div class="order-meta">
                                    <i class="fas fa-cube mt-1"></i>
                                    <span>Hàng hóa vận tải • ${o.createdAt}</span>
                                </div>
                            </div>
                        `);
                    });
                });

            fetch('/Admin/LiveDriverLocations')
                .then(r => r.json())
                .then(drivers => {
                    drivers.forEach(d => {
                        const color = d.status === 'Available' ? '#28c76f' : '#ff9f43';
                        if (markers[d.driverId]) {
                            markers[d.driverId].setLatLng([d.lat, d.lng]);
                        } else {
                            markers[d.driverId] = L.circleMarker([d.lat, d.lng], {
                                radius: 8, fillColor: color, color: '#fff', weight: 2, fillOpacity: 0.8
                            }).addTo(map).bindPopup(`<b>${d.name}</b><br>Trạng thái: ${d.status}`);
                        }
                    });
                    $('#activeTrucksCount').text(drivers.length);
                    $('#totalTrucksCount').text(drivers.length + 2);
                    $('#readyTrucksCount').text(drivers.filter(d => d.status === 'Available').length);
                });
        }
    </script>
}
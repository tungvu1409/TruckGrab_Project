@model IEnumerable<TruckGrab.web.Models.Driver>

@{
    ViewData["Title"] = "Quản lý Tài xế";
    Layout = "_DispatchLayout";
    var users = ViewBag.Users as Dictionary<int, TruckGrab.web.Models.User>;
    var sortBy = ViewBag.SortBy as string ?? "Id";
    var sortOrder = ViewBag.SortOrder as string ?? "asc";
    var nextSortOrder = ViewBag.NextSortOrder as string ?? "desc";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-id-card text-accent-green"></i>
        <span>Quản lý Tài xế</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
            <i class="fas fa-rotate me-1"></i> Làm mới
        </button>
    </div>
</div>

<div class="card bg-secondary bg-opacity-10 border-0 shadow-sm mt-3 overflow-hidden">
    <div class="card-header border-bottom border-secondary bg-transparent py-3">
        <h5 class="mb-0 fw-bold">Danh sách tất cả tài xế</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-dark mb-0 align-middle">
                    <thead class="bg-dark bg-opacity-50">
                        <tr>
                            <th class="ps-3 py-3 border-secondary">
                                <a href="@Url.Action("ManageDrivers", new { sortBy = "Id", sortOrder = sortBy == "Id" ? nextSortOrder : "asc" })" class="text-accent-green text-decoration-none">
                                    ID @if (sortBy == "Id") { <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down") ms-1"></i> }
                                </a>
                            </th>
                            <th class="border-secondary">Họ tên</th>
                            <th class="border-secondary">
                                <a href="@Url.Action("ManageDrivers", new { sortBy = "LicenseNumber", sortOrder = sortBy == "LicenseNumber" ? nextSortOrder : "asc" })" class="text-accent-green text-decoration-none">
                                    Số bằng lái @if (sortBy == "LicenseNumber") { <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down") ms-1"></i> }
                                </a>
                            </th>
                            <th class="border-secondary">Số điện thoại</th>
                            <th class="border-secondary">Trạng thái</th>
                            <th class="pe-3 border-secondary">Ngày đăng ký</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var driver in Model)
                        {
                            var user = users?.GetValueOrDefault(driver.UserId);
                            <tr>
                                <td class="ps-3 text-accent-green fw-bold">#@driver.Id</td>
                                <td class="fw-bold">@(user?.Profile?.FullName ?? user?.UserName ?? "N/A")</td>
                                <td class="small">@driver.LicenseNumber</td>
                                <td class="small">@(user?.Profile?.Phone ?? "N/A")</td>
                                <td>
                                    <span class="badge rounded-pill bg-@(driver.Status.ToString().ToLower() switch
                                    {
                                        "available" => "success",
                                        "busy" => "warning text-dark",
                                        "offduty" => "secondary",
                                        _ => "light text-dark"
                                    })">
                                        @driver.Status.ToString().ToUpper()
                                    </span>
                                </td>
                                <td class="small text-secondary pe-3">@(user?.CreatedAt.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-user-slash fs-1 mb-3 opacity-25"></i>
                <p class="text-secondary">Không tìm thấy tài xế nào.</p>
            </div>
        }
    </div>
</div>
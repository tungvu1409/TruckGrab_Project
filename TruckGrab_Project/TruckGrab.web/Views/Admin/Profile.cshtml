@model TruckGrab.web.Models.UserProfile
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-user-circle text-accent-cyan"></i>
        <span>Hồ sơ cá nhân</span>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 border-success text-success mb-4">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <div class="dispatch-stat-card border-top-0 p-4">
            <form asp-action="EditProfile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                
                <div class="mb-4 text-center">
                    <div class="user-avatar-large mx-auto bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px; font-size: 2.5rem;">
                        @(Model.FullName?[0].ToString().ToUpper() ?? "U")
                    </div>
                    <h4 class="text-white mb-0">@Model.FullName</h4>
                    <p class="text-secondary small">Quản trị viên hệ thống</p>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label text-secondary small fw-bold">HỌ VÀ TÊN</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fas fa-user"></i></span>
                            <input asp-for="FullName" class="form-control bg-dark border-secondary text-white" placeholder="Nhập họ và tên..." required />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-secondary small fw-bold">EMAIL</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control bg-dark border-secondary text-white" placeholder="Nhập email..." />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-secondary small fw-bold">SỐ ĐIỆN THOẠI</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fas fa-phone"></i></span>
                            <input asp-for="Phone" class="form-control bg-dark border-secondary text-white" placeholder="Nhập số điện thoại..." />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-secondary small fw-bold">ĐỊA CHỈ</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fas fa-location-dot"></i></span>
                            <textarea asp-for="Address" class="form-control bg-dark border-secondary text-white" rows="2" placeholder="Nhập địa chỉ..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-10">
                    <button type="submit" class="btn btn-warning w-100 fw-bold py-2 shadow-sm">
                        LƯU THAY ĐỔI <i class="fas fa-save ms-2"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

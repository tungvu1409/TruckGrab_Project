@model TruckGrab.web.Models.Driver
@{
    ViewData["Title"] = "Gán xe tải cho tài xế";
    Layout = "_DispatchLayout";
    var trucks = ViewBag.Trucks as IEnumerable<TruckGrab.web.Models.Truck>;
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-link text-accent-cyan"></i>
        <span>Gán xe tải cho: @ViewBag.DriverName</span>
    </div>
    <a href="@Url.Action("ManageDrivers", "Admin")" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="dispatch-stat-card border-top-0 p-4">
            <div class="mb-4 text-center">
                <div class="bg-accent-cyan bg-opacity-10 text-accent-cyan fw-bold rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem; border: 2px dashed var(--accent-cyan);">
                    <i class="fas fa-truck"></i>
                </div>
                <h4 class="text-white mb-0">Quản lý gán phương tiện</h4>
                <p class="text-secondary small">Chọn xe tải từ danh sách khả dụng</p>
            </div>

            <form asp-action="AssignTruck" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-4">
                    <label class="form-label text-secondary small fw-bold mb-3">DANH SÁCH XE TẢI KHẢ DỤNG</label>
                    <div class="list-group">
                        <label class="list-group-item list-group-item-action bg-dark border-secondary border-opacity-10 text-white py-3">
                            <input class="form-check-input me-3" type="radio" name="truckId" value="0" @(!Model.CurrentTruckId.HasValue ? "checked" : "")>
                            <span class="fw-bold text-danger">KHÔNG GÁN XE (Trống)</span>
                        </label>
                        
                        @foreach (var truck in trucks)
                        {
                            <label class="list-group-item list-group-item-action bg-dark border-secondary border-opacity-10 text-white py-3">
                                <input class="form-check-input me-3" type="radio" name="truckId" value="@truck.Id" @(Model.CurrentTruckId == truck.Id ? "checked" : "")>
                                <div class="d-inline-block">
                                    <div class="fw-bold text-accent-cyan">@truck.LicensePlate</div>
                                    <div class="small text-secondary">@truck.Brand @truck.Model (@truck.FuelType)</div>
                                </div>
                                @if (Model.CurrentTruckId == truck.Id)
                                {
                                    <span class="badge bg-primary float-end">HIỆN TẠI</span>
                                }
                            </label>
                        }
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-10">
                    <button type="submit" class="btn btn-warning w-100 fw-bold py-2 shadow-sm">
                        XÁC NHẬN GÁN XE <i class="fas fa-check-circle ms-2"></i>
                    </button>
                </div>
            </form>
        </div>

        <div class="mt-4 p-3 bg-secondary bg-opacity-10 rounded-3">
            <h6 class="text-white small fw-bold mb-2"><i class="fas fa-info-circle me-1 text-info"></i> Lưu ý:</h6>
            <ul class="text-secondary small mb-0 ps-3">
                <li>Xe đang được gán cho tài xế khác sẽ không hiện trong danh sách này.</li>
                <li>Khi gán xe mới, xe cũ của tài xế (nếu có) sẽ tự động được chuyển về trạng thái "Available".</li>
                <li>Xe được gán sẽ chuyển sang trạng thái "On Delivery" (Đang hoạt động).</li>
            </ul>
        </div>
    </div>
</div>

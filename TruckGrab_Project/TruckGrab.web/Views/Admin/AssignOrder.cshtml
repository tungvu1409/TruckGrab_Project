@model TruckGrab.web.Models.Order
@{
    ViewData["Title"] = "Điều phối - " + Model.OrderCode;
    Layout = "_DispatchLayout";
    var recommendedDrivers = ViewBag.RecommendedDrivers as List<TruckGrab.web.Controllers.RecommendedDriverViewModel> ?? new List<TruckGrab.web.Controllers.RecommendedDriverViewModel>();
    var pickupAddress = ViewBag.PickupAddress as string;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .summary-card { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05); }
        .recommendation-card { border-left: 4px solid var(--accent-orange); }
        .avatar-init { width: 40px; height: 40px; border-radius: 10px; background: var(--accent-cyan); color: #000; font-weight: 800; display: flex; align-items: center; justify-content: center; }
    </style>
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-user-plus text-accent-orange"></i>
        <span>Điều phối tài xế cho đơn @Model.OrderCode</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ManageOrders")" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4 mt-1">
    <!-- Order Summary -->
    <div class="col-lg-4">
        <div class="card summary-card border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-dark bg-opacity-25 py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-file-invoice me-2"></i>Chi tiết đơn hàng</h6>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Loại hàng & Khối lượng</label>
                    <div class="h5 fw-bold text-accent-orange">@Model.CargoType • @Model.Weight kg</div>
                </div>
                <div class="mb-4">
                    <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Quãng đường & Giá</label>
                    <div class="h5 fw-bold">@Model.DistanceKm km • <span class="text-warning">@Model.TotalPrice.ToString("N0") đ</span></div>
                </div>
                <hr class="border-secondary opacity-25" />
                <div class="mb-0">
                    <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Điểm bốc hàng</label>
                    <div class="small fw-bold"><i class="fas fa-location-dot text-danger me-2"></i>@pickupAddress</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recommendations -->
    <div class="col-lg-8">
        <div class="card bg-secondary bg-opacity-10 border-0 rounded-4 recommendation-card mb-4">
            <div class="card-header border-bottom border-secondary bg-transparent py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-bolt text-warning me-2"></i>Đề xuất thông minh: Tài xế gần nhất</h6>
            </div>
            <div class="card-body p-0">
                @if (recommendedDrivers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead>
                                <tr class="text-secondary small">
                                    <th class="ps-3 border-0">TÀI XẾ</th>
                                    <th class="border-0">KHOẢNG CÁCH</th>
                                    <th class="border-0">TRẠNG THÁI</th>
                                    <th class="text-end pe-3 border-0">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rec in recommendedDrivers)
                                {
                                    <tr>
                                        <td class="ps-3 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar-init">@rec.Name[0]</div>
                                                <div>
                                                    <div class="fw-bold">@rec.Name</div>
                                                    <div class="text-secondary small">ID: #@rec.DriverId</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">
                                                @rec.DistanceKm.ToString("F2") km
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-@(rec.Status.ToLower() == "active" || rec.Status.ToLower() == "available" ? "success" : "warning text-dark")">
                                                @rec.Status.ToUpper()
                                            </span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <form asp-action="SubmitAssignment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@Model.Id" />
                                                <input type="hidden" name="driverId" value="@rec.DriverId" />
                                                <button type="submit" class="btn btn-xs btn-warning fw-bold px-3 py-2">
                                                    CHỌN TÀI XẾ <i class="fas fa-check-circle ms-1"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-user-slash fs-1 text-secondary opacity-25 mb-3"></i>
                        <h6 class="text-secondary">Không tìm thấy tài xế nào đang online gần khu vực này.</h6>
                    </div>
                }
            </div>
        </div>

        <div class="card bg-secondary bg-opacity-10 border-0 rounded-4 overflow-hidden shadow">
            <div class="card-header bg-dark bg-opacity-25 py-2">
                <small class="fw-bold text-secondary text-uppercase"><i class="fas fa-map-location-dot me-2"></i>Trực quan hóa vị trí</small>
            </div>
            <div id="dispatchLiveMap" style="height: 400px;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        $(document).ready(function() {
            const firstLat = @(recommendedDrivers.FirstOrDefault()?.Lat ?? 10.7769);
            const firstLng = @(recommendedDrivers.FirstOrDefault()?.Lng ?? 106.7009);
            
            const map = L.map('dispatchLiveMap').setView([firstLat, firstLng], 14);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OSM',
                subdomains: 'abcd',
                maxZoom: 20
            }).addTo(map);

            @foreach (var d in recommendedDrivers)
            {
                <text>
                L.marker([@d.Lat, @d.Lng], {
                    icon: L.divIcon({
                        className: 'custom-div-icon',
                        html: "<div style='background-color:#ff9f43; width:12px; height:12px; border-radius:50%; border:2px solid white;'></div>",
                        iconSize: [12, 12],
                        iconAnchor: [6, 6]
                    })
                }).addTo(map).bindPopup("<b>Tài xế: @d.Name</b><br>Cách: @d.DistanceKm.ToString("F2") km");
                </text>
            }
        });
    </script>
}

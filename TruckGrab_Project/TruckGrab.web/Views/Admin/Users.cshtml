@model IEnumerable<TruckGrab.web.Models.User>

@{
    ViewData["Title"] = "Quản lý Người dùng";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-users text-accent-purple"></i>
        <span>Quản lý Người dùng</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
            <i class="fas fa-rotate me-1"></i> Làm mới
        </button>
    </div>
</div>

<div class="card bg-secondary bg-opacity-10 border-0 shadow-sm mt-3 overflow-hidden">
    <div class="card-header border-bottom border-secondary bg-transparent py-3">
        <h5 class="mb-0 fw-bold">Danh sách tất cả người dùng</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-dark mb-0 align-middle">
                    <thead class="bg-dark bg-opacity-50">
                        <tr>
                            <th class="ps-3 py-3 border-secondary">ID</th>
                            <th class="border-secondary">Tên đăng nhập</th>
                            <th class="border-secondary">Vai trò</th>
                            <th class="border-secondary">Trạng thái</th>
                            <th class="border-secondary">Ngày tham gia</th>
                            <th class="text-center pe-3 border-secondary">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-3 text-accent-purple fw-bold">#@user.Id</td>
                                <td class="fw-bold">@user.UserName</td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 px-3">
                                        @user.Role.ToString().ToUpper()
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success px-3">ACTIVE</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger px-3">INACTIVE</span>
                                    }
                                </td>
                                <td class="small text-secondary">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-center pe-3">
                                    <div class="btn-group">
                                        <a href="@Url.Action("UserDetails", "Admin", new { id = user.Id })" class="btn btn-xs btn-outline-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (user.IsActive)
                                        {
                                            <button class="btn btn-xs btn-outline-warning" onclick="deactivateUser(@user.Id)">
                                                <i class="fas fa-user-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-xs btn-outline-success" onclick="activateUser(@user.Id)">
                                                <i class="fas fa-user-check"></i>
                                            </button>
                                        }
                                        <button class="btn btn-xs btn-outline-danger" onclick="deleteUser(@user.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-user-large-slash fs-1 mb-3 opacity-25"></i>
                <p class="text-secondary">Không tìm thấy người dùng nào.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function activateUser(userId) {
            if (confirm('Bạn có chắc chắn muốn kích hoạt người dùng này?')) {
                // Assuming POST to toggle exists or individual endpoints
                fetch(`/Admin/Manage/Users/Toggle/${userId}`, { method: 'POST' }).then(() => location.reload());
            }
        }

        function deactivateUser(userId) {
            if (confirm('Bạn có chắc chắn muốn vô hiệu hóa người dùng này?')) {
                fetch(`/Admin/Manage/Users/Toggle/${userId}`, { method: 'POST' }).then(() => location.reload());
            }
        }

        function deleteUser(userId) {
            if (confirm('Bạn có chắc chắn muốn xóa người dùng này? Thao tác này không thể hoàn tác.')) {
                fetch(`/Admin/Manage/Users/Delete/${userId}`, { method: 'POST' }).then(() => location.reload());
            }
        }
    </script>
}
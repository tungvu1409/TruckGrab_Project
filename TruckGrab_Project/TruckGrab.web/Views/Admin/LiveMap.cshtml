@{
    ViewData["Title"] = "Bản đồ trực tuyến";
    Layout = "_DispatchLayout";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .dispatch-main { padding: 0 !important; overflow: hidden; }
        .live-map-overlay {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 1000;
            background: rgba(11, 14, 20, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 15px 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        #adminFullMap { height: calc(100vh - 0px); width: 100%; }
        .leaflet-container { background: #0b0e14 !important; }
    </style>
}

<div class="position-relative">
    <div class="live-map-overlay">
        <div class="d-flex align-items-center gap-3">
            <div class="dispatch-page-title m-0">
                <i class="fas fa-satellite text-accent-cyan pulse-animation"></i>
                <span>Giám sát trực tuyến</span>
            </div>
            <div class="vr bg-secondary opacity-25" style="height: 20px;"></div>
            <div class="d-flex gap-2">
                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-3 py-2">
                    <i class="fas fa-circle me-2 small"></i><span id="driverCount">0</span> TÀI XẾ ONLINE
                </span>
            </div>
        </div>
    </div>
    
    <div id="adminFullMap"></div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const map = L.map('adminFullMap', { zoomControl: false }).setView([10.7769, 106.7009], 13);
        L.control.zoom({ position: 'bottomright' }).addTo(map);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);

        let markers = {};

        function updateAdminMap() {
            fetch('/Admin/LiveDriverLocations')
                .then(r => r.json())
                .then(drivers => {
                    document.getElementById('driverCount').textContent = drivers.length;
                    const currentIds = new Set(drivers.map(d => d.driverId));
                    
                    drivers.forEach(d => {
                        const pos = [d.lat, d.lng];
                        const lastSeen = new Date(d.updatedAt).toLocaleTimeString('en-GB');
                        const popupText = `
                            <div class="p-2" style="background:#1a1f2b; color:white; border-radius:8px; min-width:150px;">
                                <div class="fw-bold text-accent-cyan border-bottom border-secondary pb-1 mb-2">${d.name}</div>
                                <div class="small mb-1"><i class="fas fa-info-circle me-2 opacity-50"></i>${d.status}</div>
                                <div class="small opacity-50"><i class="fas fa-clock me-2"></i>${lastSeen}</div>
                            </div>`;

                        if (markers[d.driverId]) {
                            markers[d.driverId].setLatLng(pos).setPopupContent(popupText);
                        } else {
                            markers[d.driverId] = L.marker(pos, {
                                icon: L.divIcon({
                                    className: 'custom-div-icon',
                                    html: `<div style='background-color:var(--accent-cyan); width:16px; height:16px; border-radius:50%; border:3px solid white; box-shadow: 0 0 15px rgba(0,207,232,0.5);'></div>`,
                                    iconSize: [16, 16],
                                    iconAnchor: [8, 8]
                                })
                            }).addTo(map).bindPopup(popupText, { className: 'dispatch-popup' });
                        }
                    });

                    Object.keys(markers).forEach(id => {
                        if (!currentIds.has(parseInt(id))) {
                            map.removeLayer(markers[id]);
                            delete markers[id];
                        }
                    });
                });
        }

        setInterval(updateAdminMap, 15000);
        updateAdminMap();
    </script>
}

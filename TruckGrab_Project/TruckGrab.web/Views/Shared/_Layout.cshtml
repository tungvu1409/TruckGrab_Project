<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TruckGrab.web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TruckGrab.web.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

<body>
    <header>
        <partial name="_Navbar" />
    </header>

    @{
        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    }

    <!-- Bottom Navigation (Mobile Only) -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="mobile-nav">
            @if (role == "Admin")
            {
                <a href="@Url.Action("Index", "Admin")" class="mobile-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>Dash</span>
                </a>
                <a href="@Url.Action("ManageOrders", "Admin")" class="mobile-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageOrders" ? "active" : "")">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Orders</span>
                </a>
                <a href="@Url.Action("ManageDrivers", "Admin")" class="mobile-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageDrivers" ? "active" : "")">
                    <i class="fas fa-truck"></i>
                    <span>Drivers</span>
                </a>
                <a href="@Url.Action("LiveMap", "Admin")" class="mobile-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "LiveMap" ? "active" : "")">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>Map</span>
                </a>
            }
            else if (role == "Driver")
            {
                <a href="@Url.Action("Index", "Driver")" class="mobile-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Driver" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dash</span>
                </a>
                <a href="@Url.Action("MyOrders", "Driver")" class="mobile-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "MyOrders" ? "active" : "")">
                    <i class="fas fa-clipboard-list"></i>
                    <span>Orders</span>
                </a>
                <a href="@Url.Action("Profile", "Driver")" class="mobile-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                    <i class="fas fa-user-circle"></i>
                    <span>Profile</span>
                </a>
            }
            else if (role == "Customer")
            {
                <a href="@Url.Action("Index", "Customer")" class="mobile-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customer" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
                <a href="@Url.Action("Orders", "Customer")" class="mobile-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="fas fa-box"></i>
                    <span>My Orders</span>
                </a>
                <a href="@Url.Action("CreateOrder", "Customer")" class="mobile-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "CreateOrder" ? "active" : "")">
                    <i class="fas fa-plus-circle"></i>
                    <span>New Order</span>
                </a>
            }
            <a href="#" class="mobile-nav-item" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </div>
    }

    <partial name="_LogoutModal" />

    <div class="container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Driver"))
    {
        <script>
            (function() {
                console.log('[GPS] Global Driver Tracking Initialized');
                
                let lastLat = 10.7769; // Default
                let lastLng = 106.7009;

                function sendUpdate(lat, lng) {
                    console.log('[GPS] Sending global update:', lat, lng);
                    fetch('/Driver/UpdateLocation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ lat: lat, lng: lng })
                    })
                    .catch(err => console.error('[GPS] Global update failed:', err));
                }

                // Try to get real location
                if ("geolocation" in navigator) {
                    navigator.geolocation.getCurrentPosition(function(position) {
                        lastLat = position.coords.latitude;
                        lastLng = position.coords.longitude;
                        sendUpdate(lastLat, lastLng);
                    });
                } else {
                    // Fallback to default/simulated
                    sendUpdate(lastLat, lastLng);
                }

                // Periodic updates every 60 seconds
                setInterval(function() {
                    if ("geolocation" in navigator) {
                        navigator.geolocation.getCurrentPosition(function(position) {
                            sendUpdate(position.coords.latitude, position.coords.longitude);
                        }, function() {
                            sendUpdate(lastLat, lastLng);
                        });
                    } else {
                        sendUpdate(lastLat, lastLng);
                    }
                }, 60000);

                // Go offline on logout/close
                window.addEventListener('beforeunload', function() {
                    fetch('/Driver/GoOffline', { method: 'POST', keepalive: true });
                });
            })();
        </script>
    }
</body>
</html>
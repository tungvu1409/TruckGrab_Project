@using System.Security.Claims
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var userName = User.Identity?.Name;
}

<nav class="navbar navbar-expand-sm @(role == "Admin" ? "navbar-dark bg-dark" : "navbar-light bg-white") border-bottom mb-3">
    <div class="container-fluid">

        <!-- LOGO -->
        <a class="navbar-brand @(role == "Admin" ? "text-white" : "")"
           asp-controller="Home"
           asp-action="Index">
            @(role == "Admin" ? "Admin Panel" : "TruckGrab")
        </a>

        <!-- TOGGLE -->
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-between" id="navbarMain">

            <!-- LEFT MENU -->
            <ul class="navbar-nav">

                @if (role == "Admin")
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white"
                           href="#"
                           id="manageDropdown"
                           role="button"
                           data-bs-toggle="dropdown">
                            Manage
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Admin"
                                   asp-action="ManageOrders">
                                    Orders
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Admin"
                                   asp-action="ManageCustomers">
                                    Customers
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Admin"
                                   asp-action="ManageDrivers">
                                    Drivers
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-controller="Admin"
                           asp-action="Users">
                            Users
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-controller="Admin"
                           asp-action="Orders">
                            Orders
                        </a>
                    </li>
                }
                else if (role == "Driver")
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Driver"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Driver"
                           asp-action="Trips">
                            Trips
                        </a>
                    </li>
                }
                else if (role == "Customer")
                {
                    <!-- Customer / Guest -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                        href="#"
                        id="orderDropdown"
                        role="button"
                        data-bs-toggle="dropdown">
                            Orders
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                asp-controller="Customer"
                                asp-action="Orders">
                                    Your Orders
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                asp-controller="Customer"
                                asp-action="CreateOrder">
                                    New Order
                                </a>
                            </li>
                        </ul>
                    </li>


                }

            </ul>

            <!-- RIGHT AUTH -->
            <ul class="navbar-nav ms-auto">

                @if (!string.IsNullOrEmpty(userName))
                {
                    <li class="nav-item">
                        <span class="nav-link @(role == "Admin" ? "text-white" : "")">
                            @(role ?? "User"): @userName
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(role == "Admin" ? "text-warning" : "text-danger fw-bold")"
                           asp-controller="Account"
                           asp-action="Logout">
                            Logout
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Register">
                            Register
                        </a>
                    </li>
                }

            </ul>

        </div>
    </div>
</nav>
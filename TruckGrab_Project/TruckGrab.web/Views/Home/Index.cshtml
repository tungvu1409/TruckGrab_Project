@using System.Security.Claims
@{
    ViewData["Title"] = "TruckGrab - Vận tải thông minh";
}

@section Styles {
    <link rel="stylesheet" href="~/css/truckgrab-theme.css" asp-append-version="true" />
    <style>
        body { background-color: #0b0e14; color: white; }
        .hero-section {
            padding: 100px 0;
            background: radial-gradient(circle at center, #1a1f2b 0%, #0b0e14 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');
            opacity: 0.05;
            transform: rotate(30deg);
        }
        .hero-title {
            font-size: 4rem;
            font-weight: 900;
            letter-spacing: -2px;
            background: linear-gradient(to bottom, #ffffff, #8e94a5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 20px;
        }
        .feature-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 30px;
            transition: all 0.3s ease;
        }
        .feature-card:hover {
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-10px);
            border-color: #ffc107;
        }
        .feature-icon {
            font-size: 2.5rem;
            margin-bottom: 20px;
            display: inline-block;
        }
    </style>
}

<div class="hero-section text-center">
    <div class="container position-relative">
        <div class="mb-4">
            <i class="fas fa-truck-fast text-warning display-1"></i>
        </div>
        <h1 class="hero-title">TruckGrab</h1>
        <p class="lead text-secondary mb-5 mx-auto" style="max-width: 600px;">
            Giải pháp quản lý vận tải và điều phối xe thông minh dành cho doanh nghiệp hiện đại.
        </p>

        @if (!User.Identity?.IsAuthenticated ?? true)
        {
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-lg px-5 py-3 fw-bold shadow">
                    BẮT ĐẦU NGAY <i class="fas fa-arrow-right ms-2"></i>
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-5 py-3 fw-bold">
                    TẠO TÀI KHOẢN
                </a>
            </div>
        }
        else
        {
            <div class="card bg-secondary bg-opacity-10 border-0 d-inline-block p-4 rounded-4 shadow-lg">
                <h5 class="mb-3 text-white">Chào mừng trở lại, @User.Identity?.Name!</h5>
                <p class="text-secondary mb-3 small">Hệ thống đang sẵn sàng cho phiên làm việc của bạn.</p>
                <div id="redirectIndicator">
                    <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                    <span class="small">Đang chuyển hướng đến Dashboard...</span>
                </div>
            </div>
        }
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="feature-card h-100">
                <div class="feature-icon text-accent-orange"><i class="fas fa-bolt"></i></div>
                <h4 class="fw-bold">Điều phối nhanh</h4>
                <p class="text-secondary small mb-0">Thuật toán thông minh giúp kết nối chủ hàng và tài xế gần nhất chỉ trong vài giây.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card h-100">
                <div class="feature-icon text-accent-cyan"><i class="fas fa-location-dot"></i></div>
                <h4 class="fw-bold">Theo dõi thời gian thực</h4>
                <p class="text-secondary small mb-0">Giám sát vị trí xe và trạng thái đơn hàng 24/7 với bản đồ GPS chính xác.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card h-100">
                <div class="feature-icon text-accent-green"><i class="fas fa-shield-check"></i></div>
                <h4 class="fw-bold">An toàn tuyệt đối</h4>
                <p class="text-secondary small mb-0">Hệ thống bảo hiểm hàng hóa và đội ngũ tài xế được xác minh chuyên nghiệp.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const role = '@(User.FindFirst(ClaimTypes.Role)?.Value)';
            if (role) {
                setTimeout(() => {
                    if (role === 'Admin') window.location.href = '/Admin';
                    else if (role === 'Driver') window.location.href = '/Driver';
                    else if (role === 'Customer') window.location.href = '/Customer';
                }, 1000);
            }
        });
    </script>
}

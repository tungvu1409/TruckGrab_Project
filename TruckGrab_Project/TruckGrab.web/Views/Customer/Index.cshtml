@using System.Security.Claims
@{
    ViewData["Title"] = "Customer Dashboard";
    var userName = User.Identity?.Name;
    Layout = "_DispatchLayout";
}

@section Styles {
    <style>
        .booking-card {
            background: linear-gradient(135deg, #1a1f2b 0%, #11141d 100%);
            border-left: 5px solid var(--accent-orange);
            padding: 30px;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .booking-card h2 { margin: 0; font-weight: 700; color: white; }
        .booking-card p { margin: 5px 0 0 0; color: var(--text-secondary); }
        .order-item-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 12px;
            transition: all 0.2s;
            cursor: pointer;
        }
        .order-item-card:hover {
            background: rgba(255,255,255,0.06);
            border-color: var(--accent-orange);
            transform: translateX(5px);
        }
        .status-badge {
            font-size: 0.7rem;
            padding: 2px 8px;
            border-radius: 10px;
            text-transform: uppercase;
            font-weight: 700;
        }
        .status-pending { background: #6c757d22; color: #6c757d; }
        .status-confirmed { background: #00cfe822; color: #00cfe8; }
        .status-on_trip { background: #ff9f4322; color: #ff9f43; }
        .status-picking_up { background: #7367f022; color: #7367f0; }
    </style>
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-hand-holding-heart text-accent-purple"></i>
        <span>Xin chào, @userName</span>
    </div>
    <div class="d-flex gap-2">
        <a href="#" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
            <i class="fas fa-sign-out-alt"></i> Đăng xuất
        </a>
    </div>
</div>

<!-- Booking Hero -->
<div class="booking-card shadow-lg">
    <div>
        <h2>Bạn cần vận chuyển hàng?</h2>
        <p>Đặt xe ngay để nhận báo giá tốt nhất từ các tài xế tin cậy.</p>
    </div>
    <a asp-controller="Customer" asp-action="CreateOrder" class="btn btn-warning btn-lg fw-bold px-5 py-3 shadow">
        ĐẶT XE NGAY <i class="fas fa-arrow-right ms-2"></i>
    </a>
</div>

<!-- Stats Grid -->
<div class="dispatch-stats-grid">
    <div class="dispatch-stat-card cyan">
        <div class="stat-header">ĐƠN ĐANG GIAO</div>
        <div class="stat-main-value" id="activeCount">0</div>
        <div class="stat-sub-info">Theo dõi thời gian thực</div>
    </div>
    <div class="dispatch-stat-card green">
        <div class="stat-header">ĐÃ HOÀN THÀNH</div>
        <div class="stat-main-value" id="doneCount">0</div>
        <div class="stat-sub-info">Tổng số đơn hàng</div>
    </div>
    <div class="dispatch-stat-card purple">
        <div class="stat-header">ƯU ĐÃI THÀNH VIÊN</div>
        <div class="stat-main-value">Vàng</div>
        <div class="stat-sub-info">Giảm 5% cho đơn tiếp theo</div>
    </div>
</div>

<div class="dashboard-content-grid">
    <!-- Active Deliveries -->
    <div class="map-container-card">
        <div class="card-header-simple border-bottom border-secondary pb-2 mb-3 d-flex justify-content-between align-items-center">
            <span><i class="fas fa-truck-moving me-2 text-warning"></i>Theo dõi đơn hàng đang vận chuyển</span>
            <a href="/Customer/Order/History" class="btn btn-xs btn-link text-secondary text-decoration-none small">Xem tất cả <i class="fas fa-angle-right ms-1"></i></a>
        </div>
        <div id="customerOrderList" class="flex-grow-1" style="max-height: 500px; overflow-y: auto; padding-right: 5px;">
            <div class="text-center py-5 text-secondary">
                <div class="spinner-border spinner-border-sm text-warning mb-2" role="status"></div>
                <p>Đang tải danh sách đơn hàng...</p>
            </div>
        </div>
    </div>

    <!-- Side Info -->
    <div class="orders-panel">
        <div class="card-header-simple border-bottom border-secondary pb-2 mb-2">
            <span><i class="fas fa-circle-info me-2"></i>Thông tin hữu ích</span>
        </div>
        <div class="p-2">
            <div class="card bg-secondary bg-opacity-10 border-0 mb-3">
                <div class="card-body p-3">
                    <h6 class="fw-bold"><i class="fas fa-shield-halved text-success me-2"></i>Bảo hiểm hàng hóa</h6>
                    <small class="text-secondary">Tất cả đơn hàng đều được bảo hiểm mặc định lên đến 50 triệu VNĐ.</small>
                </div>
            </div>
            <div class="card bg-secondary bg-opacity-10 border-0 mb-3">
                <div class="card-body p-3">
                    <h6 class="fw-bold"><i class="fas fa-headset text-primary me-2"></i>Hỗ trợ 24/7</h6>
                    <small class="text-secondary">Hotline: 1900 3618. Chúng tôi luôn sẵn sàng hỗ trợ bạn.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadSummary();
            loadActiveOrders();
        });

        function loadSummary() {
            fetch('/Customer/GetOrdersJson')
                .then(r => r.json())
                .then(data => {
                    $('#activeCount').text(data.activeCount);
                    $('#doneCount').text(data.doneCount);
                })
                .catch(() => {
                    $('#activeCount').text(0);
                    $('#doneCount').text(0);
                });
        }

        function loadActiveOrders() {
            const list = $('#customerOrderList');
            fetch('/Customer/GetActiveOrdersJson')
                .then(r => r.json())
                .then(orders => {
                    list.empty();
                    if (orders.length === 0) {
                        list.append(`
                            <div class="text-center py-5 text-secondary">
                                <i class="fas fa-truck-ramp-box fs-1 mb-3 opacity-25"></i>
                                <p>Không có đơn hàng nào đang trong quá trình vận chuyển.</p>
                            </div>
                        `);
                        return;
                    }

                    orders.forEach(o => {
                        const statusClass = `status-${o.status}`;
                        list.append(`
                            <div class="order-item-card" onclick="window.location.href='/Order/Details/${o.id}'">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="fw-bold text-white mb-1">${o.orderCode}</div>
                                        <div class="small text-secondary">${o.createdAt}</div>
                                    </div>
                                    <span class="status-badge ${statusClass}">${o.status.replace('_', ' ')}</span>
                                </div>
                                <div class="small mb-2">
                                    <div class="text-truncate"><i class="fas fa-circle text-success me-2" style="font-size: 0.5rem;"></i>${o.pickupAddress}</div>
                                    <div class="text-truncate"><i class="fas fa-location-dot text-danger me-2" style="font-size: 0.5rem;"></i>${o.deliveryAddress}</div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-10">
                                    <div class="text-warning fw-bold">${o.totalPrice.toLocaleString()} đ</div>
                                    <div class="text-secondary small">Chi tiết <i class="fas fa-chevron-right ms-1"></i></div>
                                </div>
                            </div>
                        `);
                    });
                })
                .catch(err => {
                    list.html('<div class="text-center py-5 text-danger">Lỗi khi tải dữ liệu. Vui lòng thử lại sau.</div>');
                });
        }
    </script>
}
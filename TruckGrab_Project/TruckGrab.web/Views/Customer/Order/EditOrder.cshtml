@model TruckGrab.web.Models.Order
@{
    ViewData["Title"] = "Chỉnh Sửa Đơn Hàng";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-edit text-accent-orange"></i>
        <span>Chỉnh Sửa Đơn Hàng #@Model.OrderCode</span>
    </div>
    <div>
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2">
            TRẠNG THÁI: @Model.Status.ToUpper()
        </span>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="dispatch-stat-card border-top-0 p-4">
            <form method="post" asp-action="EditOrder">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger small"></div>

                <div class="row g-4">
                    @{
                        bool canEditPickup = Model.Status == "pending" || Model.Status == "picking";
                        bool canEditDelivery = Model.Status != "in_transit" && Model.Status != "delivered" && Model.Status != "cancelled";
                    }

                    <div class="col-12">
                        <label class="form-label text-secondary small fw-bold">ĐIỂM NHẬN HÀNG</label>
                        @if (canEditPickup)
                        {
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-warning"><i class="fas fa-location-dot"></i></span>
                                <input asp-for="PickupAddress" class="form-control bg-dark border-secondary text-white" value="@Model.PickupLocationAddress" />
                            </div>
                            <span asp-validation-for="PickupAddress" class="text-danger small"></span>
                        }
                        else
                        {
                            <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-10 text-secondary">
                                @Model.PickupLocationAddress
                                <div class="mt-1 small"><i class="fas fa-lock me-1"></i> Không thể sửa địa chỉ nhận ở trạng thái này</div>
                            </div>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label text-secondary small fw-bold">ĐIỂM GIAO HÀNG</label>
                        @if (canEditDelivery)
                        {
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-accent-cyan"><i class="fas fa-truck-ramp-box"></i></span>
                                <input asp-for="DeliveryAddress" class="form-control bg-dark border-secondary text-white" value="@Model.DeliveryLocationAddress" />
                            </div>
                            <span asp-validation-for="DeliveryAddress" class="text-danger small"></span>
                        }
                        else
                        {
                            <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-10 text-secondary">
                                @Model.DeliveryLocationAddress
                                <div class="mt-1 small"><i class="fas fa-lock me-1"></i> Không thể sửa địa chỉ giao ở trạng thái này</div>
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CargoType" class="form-label text-secondary small fw-bold">LOẠI HÀNG HÓA</label>
                        <select asp-for="CargoType" class="form-select bg-dark border-secondary text-white">
                            <option value="Standard">Tiêu chuẩn</option>
                            <option value="Heavy">Hàng nặng</option>
                            <option value="Fragile">Hàng dễ vỡ</option>
                            <option value="Hazardous">Hàng nguy hiểm</option>
                        </select>
                        <span asp-validation-for="CargoType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Weight" class="form-label text-secondary small fw-bold">KHỐI LƯỢNG (KG)</label>
                        <input asp-for="Weight" class="form-control bg-dark border-secondary text-white" type="number" step="any" />
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-5 d-flex gap-2">
                        <a class="btn btn-outline-secondary px-4" href="/Orders/Details/@Model.Id">
                            <i class="fas fa-times me-2"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-warning fw-bold px-5 flex-grow-1">
                            LƯU THAY ĐỔI <i class="fas fa-save ms-2"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
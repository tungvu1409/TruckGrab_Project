@model TruckGrab.web.Models.Order

@{
    ViewData["Title"] = "Edit Order";
}

<div class="container mt-4">
    <h2>Edit Order</h2>

    <form method="post" asp-action="EditOrder">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Order Code:</strong></label>
                    <input type="text" class="form-control" value="@Model.OrderCode" disabled />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Status:</strong></label>
                    <input type="text" class="form-control" value="@Model.Status" disabled />
                </div>

                @{
                    bool canEditPickup = Model.Status == "pending" || Model.Status == "picking";
                    bool canEditDelivery = Model.Status != "in_transit" && Model.Status != "delivered" && Model.Status != "cancelled";
                }

                @if (canEditPickup)
                {
                    <div class="mb-3">
                        <label asp-for="PickupAddress" class="form-label">Pickup Address</label>
                        <input asp-for="PickupAddress" class="form-control" value="@Model.PickupLocationAddress" />
                        <span asp-validation-for="PickupAddress" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label"><strong>Pickup Address:</strong></label>
                        <input type="text" class="form-control" value="@Model.PickupLocationAddress" disabled />
                        <small class="text-muted">Cannot edit pickup address at this status</small>
                    </div>
                }

                @if (canEditDelivery)
                {
                    <div class="mb-3">
                        <label asp-for="DeliveryAddress" class="form-label">Delivery Address</label>
                        <input asp-for="DeliveryAddress" class="form-control" value="@Model.DeliveryLocationAddress" />
                        <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label"><strong>Delivery Address:</strong></label>
                        <input type="text" class="form-control" value="@Model.DeliveryLocationAddress" disabled />
                        <small class="text-muted">Cannot edit delivery address at this status</small>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="CargoType" class="form-label">Cargo Type</label>
                    <input asp-for="CargoType" class="form-control" />
                    <span asp-validation-for="CargoType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Weight" class="form-label">Weight (kg)</label>
                    <input asp-for="Weight" class="form-control" type="number" step="any" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                    <input asp-for="DistanceKm" class="form-control" type="number" step="any" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Total Price:</strong></label>
                    <input type="text" class="form-control" value="@Model.TotalPrice" disabled />
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-3">
            Save Changes
        </button>

        <a class="btn btn-secondary mt-3" href="/Orders/Details/@Model.Id">
            Cancel
        </a>
    </form>
</div>
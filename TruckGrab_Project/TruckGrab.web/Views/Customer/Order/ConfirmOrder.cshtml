@model TruckGrab.web.Models.Order
@{
    ViewData["Title"] = "Xác Nhận Đơn Hàng";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-file-invoice text-accent-green"></i>
        <span>Xác Nhận Đơn Hàng</span>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <!-- Progress Stepper -->
        <div class="d-flex justify-content-between mb-5 position-relative">
            <div class="progress position-absolute top-50 start-0 translate-middle-y w-100" style="height: 2px; z-index: 0;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: 100%"></div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-warning text-dark fw-bold rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="fas fa-check"></i></div>
                <div class="small mt-2 text-warning fw-bold">Thông tin hàng</div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-warning text-dark fw-bold rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="fas fa-check"></i></div>
                <div class="small mt-2 text-warning fw-bold">Địa chỉ</div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-warning text-dark fw-bold rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">3</div>
                <div class="small mt-2 text-warning fw-bold">Xác nhận</div>
            </div>
        </div>

        <div class="dispatch-stat-card border-top-0 p-0 overflow-hidden">
            <div class="bg-warning text-dark p-3 fw-bold d-flex justify-content-between align-items-center">
                <span>TỔNG QUAN ĐƠN HÀNG</span>
                <span class="badge bg-dark text-warning">DỰ KIẾN</span>
            </div>
            
            <div class="p-4">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="d-flex gap-3 mb-4">
                            <div class="text-secondary"><i class="fas fa-circle-dot fs-5"></i></div>
                            <div>
                                <div class="text-secondary small fw-bold">ĐIỂM NHẬN</div>
                                <div class="text-white">@Model.PickupAddress</div>
                            </div>
                        </div>
                        <div class="d-flex gap-3">
                            <div class="text-accent-cyan"><i class="fas fa-location-arrow fs-5"></i></div>
                            <div>
                                <div class="text-secondary small fw-bold">ĐIỂM GIAO</div>
                                <div class="text-white">@Model.DeliveryAddress</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                            <div class="text-secondary small fw-bold mb-1">LOẠI HÀNG</div>
                            <div class="text-white fw-bold">@Model.CargoType</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                            <div class="text-secondary small fw-bold mb-1">KHỐI LƯỢNG</div>
                            <div class="text-white fw-bold">@Model.Weight kg</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-4 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-4 mt-2">
                            <div class="row align-items-center">
                                <div class="col">
                                    <div class="text-secondary small fw-bold">KHOẢNG CÁCH DỰ KIẾN</div>
                                    <div class="text-white fs-4 fw-bold">@Model.DistanceKm.ToString("0.00") km</div>
                                </div>
                                <div class="col-auto text-end">
                                    <div class="text-warning small fw-bold">TỔNG CHI PHÍ TẠM TÍNH</div>
                                    <div class="text-warning fs-2 fw-black">
                                        @Model.TotalPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <form method="post" asp-action="ConfirmOrderPost" class="mt-5">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-secondary btn-lg px-4" asp-action="SelectAddress">
                            <i class="fas fa-chevron-left me-2"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning btn-lg fw-bold px-5 flex-grow-1 shadow-lg">
                            ĐẶT XE NGAY <i class="fas fa-paper-plane ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

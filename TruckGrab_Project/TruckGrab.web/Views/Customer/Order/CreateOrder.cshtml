@model TruckGrab.web.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<div class="container mt-4">
    <h2>Create New Order</h2>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Weight" class="form-label">Weight (kg)</label>
            <input asp-for="Weight" class="form-control" type="number" step="any" required />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>



        <div class="mb-3">
            <label asp-for="CargoType" class="form-label">Cargo Type</label>
            <input asp-for="CargoType" class="form-control" />
            <span asp-validation-for="CargoType" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Next
        </button>

        <a class="btn btn-secondary" asp-action="Index">
            Cancel
        </a>
    </form>
</div>
@model TruckGrab.web.Models.Order
@{
    ViewData["Title"] = "Tạo Đơn Hàng Mới";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-plus-circle text-accent-orange"></i>
        <span>Tạo Đơn Hàng Mới</span>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <!-- Progress Stepper -->
        <div class="d-flex justify-content-between mb-5 position-relative">
            <div class="progress position-absolute top-50 start-0 translate-middle-y w-100" style="height: 2px; z-index: 0;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: 0%"></div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-warning text-dark fw-bold rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">1</div>
                <div class="small mt-2 text-warning fw-bold">Thông tin hàng</div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-secondary text-white rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">2</div>
                <div class="small mt-2 text-secondary">Địa chỉ</div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-secondary text-white rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">3</div>
                <div class="small mt-2 text-secondary">Xác nhận</div>
            </div>
        </div>

        <div class="dispatch-stat-card border-top-0 p-4">
            <h5 class="mb-4 text-white border-bottom border-secondary pb-3">Bước 1: Đặc điểm hàng hóa</h5>
            
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger small"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Weight" class="form-label text-secondary small fw-bold">KHỐI LƯỢNG (KG)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary border-end-0"><i class="fas fa-weight-hanging"></i></span>
                                <input asp-for="Weight" class="form-control bg-dark border-secondary text-white border-start-0" type="number" step="any" placeholder="Nhập khối lượng..." required />
                            </div>
                            <span asp-validation-for="Weight" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CargoType" class="form-label text-secondary small fw-bold">LOẠI HÀNG HÓA</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary border-end-0"><i class="fas fa-box"></i></span>
                                <select asp-for="CargoType" class="form-select bg-dark border-secondary text-white border-start-0">
                                    <option value="Standard">Tiêu chuẩn</option>
                                    <option value="Heavy">Hàng nặng</option>
                                    <option value="Fragile">Hàng dễ vỡ</option>
                                    <option value="Hazardous">Hàng nguy hiểm</option>
                                </select>
                            </div>
                            <span asp-validation-for="CargoType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12 mt-5 d-flex justify-content-between">
                        <a class="btn btn-outline-secondary px-4" asp-action="Index">
                            <i class="fas fa-times me-2"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-warning fw-bold px-5">
                            TIẾP THEO <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
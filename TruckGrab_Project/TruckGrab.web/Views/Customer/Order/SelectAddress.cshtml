@model TruckGrab.web.Models.Order

@{
    ViewData["Title"] = "Select Addresses";
}

<div class="container mt-4">
    <h2>Select Pickup and Delivery Addresses</h2>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h4>Pickup Address</h4>
                <div class="form-group">
                    <input type="text" asp-for="PickupAddress" class="form-control" placeholder="Click 'Choose on Map' to select" readonly required />
                    <span asp-validation-for="PickupAddress" class="text-danger"></span>
                </div>
                <button type="button" class="btn btn-info" onclick="openMapForPickup()">
                    Select on Map
                </button>
            </div>
            <div class="col-md-6">
                <h4>Delivery Address</h4>
                <div class="form-group">
                    <input type="text" asp-for="DeliveryAddress" class="form-control" placeholder="Click 'Choose on Map' to select" readonly required />
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>
                <button type="button" class="btn btn-info" onclick="openMapForDelivery()">
                    Select on Map
                </button>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success" id="submitBtn">
                Create Order
            </button>
            <a class="btn btn-secondary" asp-action="CreateOrder">
                Back
            </a>
        </div>
    </form>
</div>

<!-- Map Modal -->
<div id="mapModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mapModalTitle">Select Location on Map</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="map" style="height: 500px; width: 100%;"></div>
                <p class="mt-2 text-muted">Click on the map to select a location</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmBtn" onclick="confirmSelection()">Confirm Location</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    let map, marker;
    let currentAddressType = null;
    let selectedLatLng = null;
    let mapModal;

    document.addEventListener("DOMContentLoaded", function() {
        mapModal = new bootstrap.Modal(document.getElementById('mapModal'));
        
        document.getElementById('mapModal').addEventListener('shown.bs.modal', function () {
            if (!map) {
                const defaultCenter = [3.1390, 101.6869]; // KL defaults, update if necessary
                map = L.map('map').setView(defaultCenter, 12);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors',
                    maxZoom: 19,
                }).addTo(map);

                map.on('click', function(event) {
                    placeMarker(event.latlng);
                });

                // Request user's GPS location
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(function(position) {
                        const userLat = position.coords.latitude;
                        const userLng = position.coords.longitude;
                        map.setView([userLat, userLng], 15);
                        // Automatically place a marker at their location to speed up the process
                        placeMarker({lat: userLat, lng: userLng});
                    }, function(error) {
                        console.warn('Geolocation error:', error);
                    }, { timeout: 10000 });
                }
            }
            map.invalidateSize();
        });

        document.getElementById('mapModal').addEventListener('hidden.bs.modal', function () {
            if (map) {
                map.remove();
                map = null;
            }
            marker = null;
            selectedLatLng = null;
            currentAddressType = null;
            document.getElementById('confirmBtn').textContent = 'Confirm Location';
        });
    });

    function openMapForPickup() {
        currentAddressType = 'pickup';
        document.getElementById('mapModalTitle').textContent = 'Select Pickup Location';
        if(mapModal) mapModal.show();
    }

    function openMapForDelivery() {
        currentAddressType = 'delivery';
        document.getElementById('mapModalTitle').textContent = 'Select Delivery Location';
        if(mapModal) mapModal.show();
    }

    function placeMarker(latlng) {
        selectedLatLng = latlng;

        if (marker) {
            marker.setLatLng(latlng);
        } else {
            marker = L.marker(latlng).addTo(map);
        }

        reverseGeocode(latlng.lat, latlng.lng);
    }

    async function reverseGeocode(lat, lon) {
        try {
            document.getElementById('confirmBtn').textContent = 'Loading Address...';
            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`);
            if (!response.ok) {
                throw new Error('Reverse geocoding request failed');
            }

            const data = await response.json();
            const address = data.display_name || `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
            
            document.getElementById('confirmBtn').textContent = `Confirm: ${address.substring(0, 40)}...`;
        } catch (error) {
            console.error(error);
            document.getElementById('confirmBtn').textContent = 'Confirm Location';
        }
    }

    function confirmSelection() {
        if (!selectedLatLng || !currentAddressType) {
            alert('Please select a location on the map');
            return;
        }

        const lat = selectedLatLng.lat;
        const lon = selectedLatLng.lng;

        // Optionally, reverse geocode again, but we can just use the lat/lon if needed.
        // For now, we'll fetch the address to make sure we populate the text box properly.
        document.getElementById('confirmBtn').textContent = 'Confirming...';
        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`)
            .then(response => response.json())
            .then(data => {
                const address = data.display_name || `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
                
                if (currentAddressType === 'pickup') {
                    document.getElementById('PickupAddress').value = address;
                } else if (currentAddressType === 'delivery') {
                    document.getElementById('DeliveryAddress').value = address;
                }

                mapModal.hide();
            })
            .catch(error => {
                console.error(error);
                alert('Unable to resolve address. Please try another location.');
                document.getElementById('confirmBtn').textContent = 'Confirm Location';
            });
    }
</script>
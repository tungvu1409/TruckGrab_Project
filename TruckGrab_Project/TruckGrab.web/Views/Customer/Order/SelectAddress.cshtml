@model TruckGrab.web.Models.Order
@{
    ViewData["Title"] = "Chọn Địa Chỉ";
    Layout = "_DispatchLayout";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .map-wrapper {
            height: 400px;
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 20px;
        }
        #map { height: 100%; width: 100%; background: #f8f9fa; }
        .location-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .location-card:hover, .location-card.active {
            background: rgba(255,159,67,0.1);
            border-color: var(--accent-orange);
        }
    </style>
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-map-marked-alt text-accent-cyan"></i>
        <span>Chọn Lộ Trình Vận Chuyển</span>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-10">
        <div class="d-flex justify-content-between mb-5 position-relative">
            <div class="progress position-absolute top-50 start-0 translate-middle-y w-100" style="height: 2px; z-index: 0;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: 50%"></div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-warning text-dark fw-bold rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="fas fa-check"></i></div>
                <div class="small mt-2 text-warning fw-bold">Thông tin hàng</div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-warning text-dark fw-bold rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">2</div>
                <div class="small mt-2 text-warning fw-bold">Địa chỉ</div>
            </div>
            <div class="step-item text-center position-relative z-1">
                <div class="step-icon bg-secondary text-white rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">3</div>
                <div class="small mt-2 text-secondary">Xác nhận</div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <form method="post" id="addressForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger small"></div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold mb-3">ĐIỂM NHẬN HÀNG (PICKUP)</label>
                        <div class="location-card active" onclick="focusPickup()">
                            <div class="d-flex gap-3">
                                <div class="text-accent-orange fs-4"><i class="fas fa-location-dot"></i></div>
                                <div class="flex-grow-1">
                                    <input type="text" asp-for="PickupAddress" class="form-control bg-transparent border-0 p-0 text-white shadow-none" placeholder="Chọn trên bản đồ..." readonly required />
                                    <div class="text-secondary small mt-1">Vui lòng nhấp vào bản đồ để chọn</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-secondary small fw-bold mb-3">ĐIỂM GIAO HÀNG (DELIVERY)</label>
                        <div class="location-card" id="deliveryCard" onclick="focusDelivery()">
                            <div class="d-flex gap-3">
                                <div class="text-accent-cyan fs-4"><i class="fas fa-truck-ramp-box"></i></div>
                                <div class="flex-grow-1">
                                    <input type="text" asp-for="DeliveryAddress" class="form-control bg-transparent border-0 p-0 text-white shadow-none" placeholder="Chọn trên bản đồ..." readonly required />
                                    <div class="text-secondary small mt-1">Nhấp vào bản đồ để đặt điểm giao</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-2">
                        <a class="btn btn-outline-secondary px-4 flex-grow-1" asp-action="CreateOrder">
                            <i class="fas fa-arrow-left me-2"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning fw-bold px-5 flex-grow-1" id="submitBtn">
                            XÁC NHẬN <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="col-lg-7">
                <div class="map-wrapper shadow-lg">
                    <div id="map"></div>
                </div>
                <div class="alert alert-info bg-info bg-opacity-10 border-info text-info small">
                    <i class="fas fa-info-circle me-2"></i> Nhấp vào bản đồ để chọn vị trí. Hệ thống sẽ tự động lấy địa chỉ chính xác.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map, pickupMarker, deliveryMarker;
        let activeMode = 'pickup';

        $(document).ready(function() {
            initMap();
        });

        function initMap() {
            map = L.map('map').setView([21.0285, 105.8542], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; TruckGrab OSM',
                subdomains: 'abcd',
                maxZoom: 20
            }).addTo(map);

            map.on('click', function(e) {
                handleMapClick(e.latlng);
            });

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(pos => {
                    map.setView([pos.coords.latitude, pos.coords.longitude], 15);
                });
            }
        }

        function focusPickup() {
            activeMode = 'pickup';
            $('.location-card').removeClass('active');
            $('.location-card:first').addClass('active');
        }

        function focusDelivery() {
            activeMode = 'delivery';
            $('.location-card').removeClass('active');
            $('#deliveryCard').addClass('active');
        }

        async function handleMapClick(latlng) {
            const address = await reverseGeocode(latlng.lat, latlng.lng);
            
            if (activeMode === 'pickup') {
                if (pickupMarker) pickupMarker.setLatLng(latlng);
                else pickupMarker = L.marker(latlng, { icon: L.divIcon({ html: '<i class="fas fa-location-dot text-warning fs-3"></i>', className: 'pulse-marker', iconSize: [20, 20] }) }).addTo(map);
                $('#PickupAddress').val(address);
                focusDelivery(); 
            } else {
                if (deliveryMarker) deliveryMarker.setLatLng(latlng);
                else deliveryMarker = L.marker(latlng, { icon: L.divIcon({ html: '<i class="fas fa-truck-ramp-box text-info fs-3"></i>', className: 'pulse-marker', iconSize: [20, 20] }) }).addTo(map);
                $('#DeliveryAddress').val(address);
            }
        }

        async function reverseGeocode(lat, lng) {
            try {
                const r = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
                const d = await r.json();
                return d.display_name || `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
            } catch {
                return `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
            }
        }
    </script>
}
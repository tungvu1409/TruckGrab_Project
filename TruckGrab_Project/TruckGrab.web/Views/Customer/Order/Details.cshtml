@model TruckGrab.web.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    Layout = "_DispatchLayout";
}

<div class="dispatch-top-bar">
    <div class="dispatch-page-title">
        <i class="fas fa-file-invoice text-accent-cyan"></i>
        <span>Chi Tiết Đơn Hàng #@Model.OrderCode</span>
    </div>
    <div class="d-flex gap-2">
        <a href="/Customer/Order/History" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="dispatch-stat-card border-top-0 p-0 overflow-hidden mb-4">
            <div class="bg-dark bg-opacity-50 p-3 border-bottom border-secondary border-opacity-10 fw-bold">
                <i class="fas fa-info-circle text-warning me-2"></i> THÔNG TIN VẬN CHUYỂN
            </div>
            <div class="p-4">
                <div class="row g-4 mb-4">
                    <div class="col-6">
                        <label class="text-secondary small fw-bold d-block mb-1">LOẠI HÀNG</label>
                        <div class="text-white fw-bold">@Model.CargoType</div>
                    </div>
                    <div class="col-6">
                        <label class="text-secondary small fw-bold d-block mb-1">KHỐI LƯỢNG</label>
                        <div class="text-white fw-bold">@Model.Weight kg</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="text-secondary small fw-bold d-block mb-2"><i class="fas fa-location-dot text-warning me-2"></i>ĐIỂM NHẬN</label>
                    <div class="p-3 bg-dark bg-opacity-25 rounded-3 border border-secondary border-opacity-10">@Model.PickupLocationAddress</div>
                </div>

                <div class="mb-0">
                    <label class="text-secondary small fw-bold d-block mb-2"><i class="fas fa-truck-ramp-box text-accent-cyan me-2"></i>ĐIỂM GIAO</label>
                    <div class="p-3 bg-dark bg-opacity-25 rounded-3 border border-secondary border-opacity-10">@Model.DeliveryLocationAddress</div>
                </div>
            </div>
        </div>

        @if (ViewBag.Logs is List<TruckGrab.web.Models.OrderStatusLog> logs && logs.Count > 0)
        {
            <div class="dispatch-stat-card border-top-0 p-0 overflow-hidden">
                <div class="bg-dark bg-opacity-50 p-3 border-bottom border-secondary border-opacity-10 fw-bold">
                    <i class="fas fa-clock-rotate-left text-accent-purple me-2"></i> HÀNH TRÌNH VẬN ĐƠN
                </div>
                <div class="p-4">
                    <div class="timeline">
                        @foreach (var log in logs)
                        {
                            <div class="d-flex gap-3 mb-4 position-relative">
                                <div class="text-accent-purple z-1"><i class="fas fa-circle-dot"></i></div>
                                <div class="flex-grow-1 border-start border-secondary border-opacity-25 ps-3" style="margin-left: -20px; padding-left: 35px !important;">
                                    <div class="fw-bold text-white">@log.NewStatus.ToUpper()</div>
                                    <div class="text-secondary small">@log.Timestamp.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (!string.IsNullOrEmpty(log.Note))
                                    {
                                        <div class="small mt-2 p-2 bg-dark bg-opacity-25 rounded border border-secondary border-opacity-10 opacity-75">@log.Note</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="dispatch-stat-card border-top-0 p-0 overflow-hidden mb-4">
            <div class="bg-dark bg-opacity-50 p-3 border-bottom border-secondary border-opacity-10 fw-bold">
                <i class="fas fa-receipt text-success me-2"></i> THANH TOÁN
            </div>
            <div class="p-4">
                <div class="d-flex justify-content-between mb-3 align-items-center">
                    <span class="text-secondary small fw-bold">QUÃNG ĐƯỜNG</span>
                    <span class="text-white fw-bold">@Model.DistanceKm km</span>
                </div>
                <div class="d-flex justify-content-between mb-3 align-items-center">
                    <span class="text-secondary small fw-bold">TRẠNG THÁI</span>
                    <span class="badge rounded-pill bg-warning text-dark px-3">@Model.Status.ToUpper()</span>
                </div>
                <hr class="border-secondary border-opacity-25 my-4" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="h5 mb-0 fw-bold text-white">TỔNG CỘNG</span>
                    <div class="text-end">
                        <div class="h3 mb-0 fw-bold text-warning">@Model.TotalPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</div>
                        <div class="text-secondary small">Đã bao gồm VAT</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Status.ToLower() == "pending")
        {
            <div class="d-grid gap-2">
                <a class="btn btn-warning fw-bold py-3 shadow-lg" href="/Order/Edit/@Model.Id">
                    <i class="fas fa-edit me-2"></i> CHỈNH SỬA ĐƠN HÀNG
                </a>
                <button class="btn btn-outline-danger py-2 border-0 opacity-75 hover-opacity-100" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    Hủy đơn hàng
                </button>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <form action="/Order/Cancel" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Xác nhận hủy đơn</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary">Bạn có chắc chắn muốn hủy đơn hàng này? Thao tác này không thể hoàn tác.</p>
                    <textarea name="reason" class="form-control bg-dark border-secondary text-white" placeholder="Lý do hủy..." required></textarea>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger px-4">XÁC NHẬN HỦY</button>
                </div>
            </form>
        </div>
    </div>
</div>

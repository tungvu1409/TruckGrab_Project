@model TruckGrab.web.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    <h2>Order Details</h2>

    <div class="card mt-3">
        <div class="card-body">
            <p><strong>Order Code:</strong> @Model.OrderCode</p>
            <p><strong>Pickup Address:</strong> @Model.PickupLocationAddress</p>
            <p><strong>Delivery Address:</strong> @Model.DeliveryLocationAddress</p>
            <p><strong>Cargo Type:</strong> @Model.CargoType</p>
            <p><strong>Weight:</strong> @Model.Weight kg</p>
            <p><strong>Distance:</strong> @Model.DistanceKm km</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Total Price:</strong> @Model.TotalPrice</p>
            @if (ViewBag.Logs is List<TruckGrab.web.Models.OrderStatusLog> logs && logs.Count > 0)
            {
                <div class="mt-4">
                    <h5>Status History</h5>
                    <ul class="list-group">
                        @foreach (var log in logs)
                        {
                            <li class="list-group-item">
                                <strong>@log.NewStatus</strong> on @log.Timestamp.ToString("g")
                                <br />
                                @log.Note
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-warning" href="/Orders/Edit/@Model.Id">Edit</a>
        <a class="btn btn-secondary" href="/customer/orders">Back to Orders</a>
    </div>
</div>
